# ---------------------------------------------------------------------------
# Cove missed-backup watchdog - configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# === Cove API ==============================================================
# Create a dedicated API user in the Management Console:
#   Management > Users > API Users > Add API user
#   - Role: Operator (lowest system role that can read backup profiles)
#   - Requires a SuperUser or Administrator to create
#   - Do NOT tick Security Officer
# The token is shown exactly once at creation.

# Customer name EXACTLY as the console shows it. Note this usually includes the
# contact email in parentheses, e.g. "Acme Ltd (admin@acme.com)". The bare
# company name is rejected.
COVE_PARTNER=

# The "Requested login name" from the API user you created
COVE_USERNAME=

# The token issued at creation, passed as the Login password
COVE_PASSWORD=

# Only change if N-able directs you to a regional host
COVE_ENDPOINT=https://api.backup.management/jsonapi


# === Detection =============================================================

# Hours without a successful backup before a data source is considered missed.
# Each active data source is checked independently.
WATCHDOG_THRESHOLD_HOURS=4

# Hours after a device is created during which it cannot alert. Covers the
# initial seed, which legitimately runs long with no prior success.
WATCHDOG_GRACE_HOURS=24

# Which devices to monitor, by backup profile name exactly as the console shows
# it. Comma-separated for more than one:
#
#   WATCHDOG_MONITOR_PROFILE=1 hour RPO Server
#   WATCHDOG_MONITOR_PROFILE=1 hour RPO Server,1 hour RPO
#
# Leave blank to monitor every server instead (OS type = server). When set, this
# REPLACES the server test, so you can monitor a workstation profile too.
#
# Matching is exact (ignoring case and surrounding spaces), not substring. That
# matters: "1 hour RPO" as a substring would also catch "1 hour RPO Server".
WATCHDOG_MONITOR_PROFILE=

# Devices on these profiles are never alerted on. Same format and matching as
# above; comma-separated. Always wins over WATCHDOG_MONITOR_PROFILE, so moving a
# device to this profile in the console mutes it. Leave blank to disable muting.
WATCHDOG_IGNORE_PROFILE=

# Timezone for email timestamps, the daily re-alert and the weekly report.
# Use a city name, which handles daylight saving: America/New_York,
# America/Chicago, America/Denver, America/Los_Angeles, Europe/London, UTC.
# NOT "EST" - it is accepted but stays UTC-5 all year, so mail arrives an hour
# late all summer. Windows names like "Eastern Standard Time" are rejected.
WATCHDOG_TIMEZONE=America/New_York

# Local hour, 0-23 on a 24-hour clock, at which a still-failing device is
# alerted on again each day. 8 = 8 am. The first alert is always immediate.
WATCHDOG_REALERT_HOUR=8

# Above this many device alerts in one run, a single summary is sent instead.
# Guards against a site-wide outage opening a hundred tickets. 1 or more.
WATCHDOG_MAX_EMAILS_PER_RUN=25


# === Weekly report =========================================================
# A scheduled report sent whether or not anything is wrong, and independently of
# alerts. If it stops arriving, the watchdog itself has stopped - which a
# problems-only alert could never tell you.

REPORT_ENABLED=true

# Full weekday name (monday ... sunday; "mon" is rejected) and local hour,
# 0-23 on a 24-hour clock.
REPORT_DAY=monday
REPORT_HOUR=8

# How many devices to list before collapsing the rest to a count.
REPORT_DEVICE_LIMIT=5


# === Email (SMTP) ==========================================================
# Works with any SMTP sender - a hosted provider or an internal relay.
# Only host, from and to are required.
# Examples: mail.smtp2go.com, smtp.sendgrid.net, smtp.office365.com

SMTP_HOST=

# 587 = STARTTLS (most common)   465 = implicit SSL   2525 = common alternate
# Avoid port 25: it is blocked outbound on most Azure compute.
SMTP_PORT=587

# starttls | ssl | none
#   starttls - upgrade a plain connection to TLS (port 587/2525)
#   ssl      - TLS from the first byte (port 465)
#   none     - no encryption; only for a trusted internal relay
SMTP_SECURITY=starttls

# Leave both blank for a relay that accepts unauthenticated mail
SMTP_USERNAME=
SMTP_PASSWORD=

# Off by default: some relays present certificates that fail verification.
# The connection is still encrypted, but the server's identity is not checked.
# Set true for a provider with a valid certificate, such as a hosted sender.
SMTP_VERIFY_CERT=false

SMTP_TIMEOUT=30


# === Alert addressing ======================================================

# Sender. Must be an address your SMTP provider allows you to send as.
ALERT_FROM=
ALERT_FROM_NAME=Cove Backup Watchdog

# Recipients, comma-separated. Point this at a ticket system address when ready.
ALERT_TO=

# Prefixed to every subject line. Leave blank for none - the one setting where
# blank does not mean "use the default".
ALERT_SUBJECT_PREFIX=[Cove]


# === State =================================================================
# What the watchdog remembers between runs: who was told what, and when.

# Local runs keep state in this file. Ignored in Azure, which always uses
# Table Storage.
WATCHDOG_STATE_PATH=watchdog_state.json

# Azure only. Table name: 3-63 letters and digits, starting with a letter.
# Created on first use.
WATCHDOG_TABLE_NAME=covewatchdog

# Azure only, optional. https://<storage-account>.table.core.windows.net to use
# a managed identity instead of a connection string. Blank = connection string.
WATCHDOG_TABLE_ACCOUNT_URL=

# Azure only, optional. A storage connection string, only to keep state in a
# different account. Blank = use AzureWebJobsStorage.
WATCHDOG_STATE_CONNECTION=


# === Schedule ==============================================================

# Azure only - how often the Function runs, in UTC. Five or six fields; six
# puts seconds first. Count them: "0 */5 * * * *" is every five MINUTES, while
# "0 */5 * * *" is every five HOURS.
WATCHDOG_SCHEDULE=0 0 * * * *
